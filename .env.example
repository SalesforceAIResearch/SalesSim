# LLM API Configuration
# OpenAI API key for GPT models
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI-compatible endpoint
# Leave blank to use default OpenAI endpoint (https://api.openai.com/v1)
OPENAI_BASE_URL=

# Optional: Custom API key for X-Api-Key header authentication
# Only needed if your endpoint requires additional authentication
X_API_KEY=

# Service Configuration
# Base URL for the lookup service (default: http://127.0.0.1:8003)
LOOKUP_BASE_URL=http://127.0.0.1:8003

# CUDA device configuration for lookup service (default: 0)
LOOKUP_CUDA_VISIBLE_DEVICES=0
